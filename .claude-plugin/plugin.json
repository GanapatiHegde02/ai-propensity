{
  "$schema": "https://www.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ai-collect",
  "description": "AI Propensity Signal Collector — captures AI usage metadata (tokens, tools, skills, agents) into a local timestamped evidence store. Privacy-first: never stores prompts, responses, or source code.",
  "version": "2.0.0",
  "author": {
    "name": "Valuezen",
    "url": "https://valuezen.ai"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/collect.py\" hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/adapters/claude-code/collect.py\" stop"
          }
        ]
      }
    ]
  }
}
